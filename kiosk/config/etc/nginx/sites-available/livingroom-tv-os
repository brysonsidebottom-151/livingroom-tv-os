server {
    listen 80 default_server;
    server_name _;
    root /var/www/livingroom-tv-os;
    index index.html;
    location /launch/ {
        proxy_pass http://127.0.0.1:7777/launch/;
    }
    location /moonlight-quit {
        proxy_pass http://127.0.0.1:7777/quit;
    }

    location /home {
        proxy_pass http://127.0.0.1:7777/home;
    }

    location / {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri $uri/ /index.html;
    }
}
