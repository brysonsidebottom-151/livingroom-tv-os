# Copy to .env and fill in once each server exists.
# Leave blank to show "Not set up" instead of "Offline".

# Jellyfin base URL, e.g. http://192.168.5.20:8096
VITE_JELLYFIN_SERVER_URL=
# Dashboard > API Keys in Jellyfin admin settings
VITE_JELLYFIN_API_KEY=
# Dashboard > Users, click your user, the id is in the page URL
VITE_JELLYFIN_USER_ID=

# Navidrome base URL, e.g. http://192.168.5.20:4533
VITE_NAVIDROME_SERVER_URL=

# Home Assistant base URL, e.g. http://192.168.5.18:8123
VITE_HOME_ASSISTANT_SERVER_URL=
